<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     哨兵威慑视窗 · 设计稿 S5 风格
     恒定纯黑底（威慑场景不跟随日夜主题），字阶放大至车机尺度
     =================================================================== -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sentry_deterrent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_sentry_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!--  智能虹膜超感智眸 (三轨逆向旋转星瞳 + 360° 激光全域扫描光束) -->
        <com.vongzh.sophon.ui.sentry.SentryEyeIrisView
            android:id="@+id/sentry_eye_view"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tv_deterrent_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s_32"
            android:letterSpacing="0.1"
            android:text="SOPHON SENTRY ACTIVE"
            android:textColor="@color/sp_rec"
            android:textSize="@dimen/sp_t_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_deterrent_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s_8"
            android:letterSpacing="0.05"
            android:text="极视全维哨兵正在录制 · 视守全程"
            android:textColor="@color/sp_tx_inverse"
            android:textSize="@dimen/sp_t_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_deterrent_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s_12"
            android:background="@drawable/sp_bg_pill"
            android:backgroundTint="@color/sp_sentry_halo"
            android:paddingHorizontal="@dimen/sp_s_20"
            android:paddingVertical="@dimen/sp_s_8"
            android:text="侦测到车身震动 · 四路全维视频已实时加密锁存"
            android:textColor="@color/sp_dg"
            android:textSize="@dimen/sp_t_subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s_24"
            android:text="轻触屏幕关闭显示"
            android:textColor="@color/sp_tx3"
            android:textSize="@dimen/sp_t_caption" />

    </LinearLayout>

</FrameLayout>
