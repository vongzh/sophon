<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     四路同步回放 · 设计稿 S4
     页头（返回 + 大标题 + 副行 + 视角切换） + 影院画面 + 事件时间轴 dock
     =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_page"
    android:orientation="vertical">

    <!-- 页头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_s_20"
        android:paddingEnd="@dimen/sp_s_20">

        <TextView
            android:id="@+id/btn_player_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sp_s_16"
            android:background="@drawable/sp_bg_pill"
            android:drawableStart="@drawable/ic_action_back"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_ac"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/sp_s_12"
            android:paddingVertical="@dimen/sp_s_6"
            android:text="返回"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="四路同步事件回放"
                android:textColor="@color/sp_tx"
                android:textSize="@dimen/sp_t_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_player_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="等待载入视频源"
                android:textAppearance="@style/TextAppearance.Sophon.Caption" />
        </LinearLayout>

        <!-- 视角切换 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sp_bg_card"
            android:elevation="@dimen/sp_elev_1"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btn_view_quad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sp_bg_pill_accent"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="四分屏"
                android:textColor="@color/sp_ac"
                android:textSize="@dimen/sp_t_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_view_front"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="前视"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label" />

            <TextView
                android:id="@+id/btn_view_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="后视"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label" />

            <TextView
                android:id="@+id/btn_view_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="左视"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label" />

            <TextView
                android:id="@+id/btn_view_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="右视"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label" />
        </LinearLayout>
    </LinearLayout>

    <!-- 影院画面（黑底舞台，20dp 圆角） -->
    <FrameLayout
        android:id="@+id/player_video_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/sp_s_20"
        android:layout_weight="1"
        android:background="@drawable/sp_bg_quad_frame"
        android:clipToOutline="true">

        <VideoView
            android:id="@+id/video_view_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- 顶部 OSD：机位 + 录制规格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_s_16"
            android:layout_marginTop="@dimen/sp_s_16"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_player_osd_cam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sp_bg_osd_chip"
                android:paddingHorizontal="@dimen/sp_s_8"
                android:paddingVertical="@dimen/sp_s_4"
                android:text="四路合成 · 全景"
                android:textAppearance="@style/TextAppearance.Sophon.Osd"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_player_osd_specs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_s_4"
                android:background="@drawable/sp_bg_osd_chip"
                android:paddingHorizontal="@dimen/sp_s_8"
                android:paddingVertical="@dimen/sp_s_2"
                android:text="--"
                android:textAppearance="@style/TextAppearance.Sophon.Osd"
                android:textSize="@dimen/sp_t_micro" />
        </LinearLayout>

        <!-- 底部渐晕 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/sp_grad_bottom_scrim" />

        <!-- 底部 OSD：真实录制水印与时间同步 -->
        <TextView
            android:id="@+id/tv_player_osd_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/sp_s_16"
            android:layout_marginBottom="@dimen/sp_s_16"
            android:fontFamily="monospace"
            android:text="--:--:--"
            android:textAppearance="@style/TextAppearance.Sophon.Osd"
            android:textSize="@dimen/sp_t_micro" />
    </FrameLayout>

    <!-- 播放控制 dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sp_surf"
        android:elevation="@dimen/sp_elev_2"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sp_s_20"
        android:paddingTop="@dimen/sp_s_16"
        android:paddingBottom="@dimen/sp_s_16">

        <!-- 事件打点时间轴 -->
        <com.vongzh.sophon.ui.widget.MarkedSeekBar
            android:id="@+id/player_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--  控制行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_s_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_prev_marker"
                android:layout_width="@dimen/sp_glass_btn"
                android:layout_height="@dimen/sp_glass_btn"
                android:background="@drawable/sp_bg_circle_glass"
                android:contentDescription="上一个标记"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="14dp"
                android:src="@drawable/ic_media_prev"
                android:tint="@color/sp_tx" />

            <ImageView
                android:id="@+id/btn_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/sp_s_12"
                android:background="@drawable/sp_bg_circle_btn"
                android:contentDescription="播放 / 暂停"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="16dp"
                android:src="@drawable/ic_media_pause"
                android:tint="@color/sp_osd_tx" />

            <ImageView
                android:id="@+id/btn_next_marker"
                android:layout_width="@dimen/sp_glass_btn"
                android:layout_height="@dimen/sp_glass_btn"
                android:background="@drawable/sp_bg_circle_glass"
                android:contentDescription="下一个标记"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="14dp"
                android:src="@drawable/ic_media_next"
                android:tint="@color/sp_tx" />

            <TextView
                android:id="@+id/tv_time_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_s_16"
                android:background="@drawable/sp_bg_pill"
                android:fontFamily="monospace"
                android:paddingHorizontal="@dimen/sp_s_12"
                android:paddingVertical="@dimen/sp_s_6"
                android:text="--:-- / --:--"
                android:textAppearance="@style/TextAppearance.Sophon.Label" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_clip_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/sp_s_12"
                android:background="@drawable/sp_bg_pill"
                android:drawableStart="@drawable/ic_clip_scissors"
                android:drawablePadding="@dimen/sp_s_6"
                android:drawableTint="@color/sp_ac"
                android:paddingHorizontal="@dimen/sp_s_16"
                android:paddingVertical="@dimen/sp_s_8"
                android:text="截取取证"
                android:textColor="@color/sp_ac"
                android:textSize="@dimen/sp_t_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_play_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sp_bg_pill"
                android:paddingHorizontal="@dimen/sp_s_16"
                android:paddingVertical="@dimen/sp_s_8"
                android:text="1.0x"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
