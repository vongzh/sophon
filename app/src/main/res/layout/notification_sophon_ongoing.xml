<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/sp_surf"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <!-- 状态指示图标 -->
    <ImageView
        android:id="@+id/iv_notif_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_status_record"  android:contentDescription="极视录制状态图标" />
        android:contentDescription="极视录制状态图标"

    <!-- 文本信息区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/sp_ac"
                android:textSize="@dimen/sp_t_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="○ 待机守护中"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_label"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_notif_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="外接存储: 已挂载"
            android:textColor="@color/sp_tx2"
            android:textSize="@dimen/sp_t_caption" />
    </LinearLayout>

    <!-- 快捷动作按钮组 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 抓拍按键 -->
        <TextView
            android:id="@+id/btn_notif_snapshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="抓拍"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_label" />

        <!-- 加锁按键 -->
        <TextView
            android:id="@+id/btn_notif_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="加锁"
            android:textColor="@color/sp_wn"
            android:textSize="@dimen/sp_t_label" />

        <!--  主页按键 -->
        <TextView
            android:id="@+id/btn_notif_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="主页"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_label" />

    </LinearLayout>

</LinearLayout>
