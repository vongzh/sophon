<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     抓拍相册查看器 · 设计稿风格统一版
     页头（返回 + 大标题 + 序号 + 删除） + 影院画面 + 圆形玻璃翻页键
     =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_page"
    android:orientation="vertical">

    <!-- 页头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_s_20"
        android:paddingEnd="@dimen/sp_s_20">

        <TextView
            android:id="@+id/btn_photo_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sp_s_16"
            android:background="@drawable/sp_bg_pill"
            android:drawableStart="@drawable/ic_action_back"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_ac"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/sp_s_16"
            android:paddingVertical="@dimen/sp_s_8"
            android:text="返回"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_photo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="抓拍照片查看器"
            android:textAppearance="@style/TextAppearance.Sophon.Headline" />

        <TextView
            android:id="@+id/tv_photo_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_s_12"
            android:background="@drawable/sp_bg_pill"
            android:fontFamily="monospace"
            android:paddingHorizontal="@dimen/sp_s_12"
            android:paddingVertical="@dimen/sp_s_4"
            android:text="(0 / 0)"
            android:textAppearance="@style/TextAppearance.Sophon.Label" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_photo_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sp_bg_pill"
            android:drawableStart="@drawable/ic_action_trash"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_dg"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/sp_s_16"
            android:paddingVertical="@dimen/sp_s_8"
            android:text="删除"
            android:textColor="@color/sp_dg"
            android:textSize="@dimen/sp_t_label"
            android:textStyle="bold" />
    </LinearLayout>

    <!--  画面 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/sp_s_20"
        android:layout_marginBottom="@dimen/sp_s_20"
        android:layout_weight="1"
        android:background="@drawable/sp_bg_quad_frame"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_photo_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="外置 U 盘 Snapshot/ 目录下暂无抓拍照片"
            android:textAppearance="@style/TextAppearance.Sophon.Subtitle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_photo_prev"
            android:layout_width="@dimen/sp_glass_btn"
            android:layout_height="@dimen/sp_glass_btn"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/sp_s_20"
            android:background="@drawable/sp_bg_circle_glass"
            android:gravity="center"
            android:text="❮"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_title" />

        <TextView
            android:id="@+id/btn_photo_next"
            android:layout_width="@dimen/sp_glass_btn"
            android:layout_height="@dimen/sp_glass_btn"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/sp_s_20"
            android:background="@drawable/sp_bg_circle_glass"
            android:gravity="center"
            android:text="❯"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_title" />
    </FrameLayout>

</LinearLayout>
