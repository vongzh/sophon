<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cockpit_dark"
    android:orientation="vertical">

    <!-- 顶部导航栏 (Photo Viewer Top Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_nav_rail"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/btn_photo_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:drawableStart="@drawable/ic_action_back"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="返回"
            android:textColor="@color/flyme_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_photo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="抓拍照片查看器"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_photo_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="(0 / 0)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 删除按钮 -->
        <TextView
            android:id="@+id/btn_photo_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:drawableStart="@drawable/ic_action_trash"
            android:drawablePadding="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="7dp"
            android:text="删除"
            android:textColor="@color/accent_danger"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_line" />

    <!-- 照片大图展示区 (Cockpit Cinema Card) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_cockpit_card"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_photo_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="外置 U 盘 Snapshot/ 目录下暂无抓拍照片"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 左右切换悬浮胶囊按钮 -->
        <TextView
            android:id="@+id/btn_photo_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:text="❮"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_photo_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center"
            android:text="❯"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </FrameLayout>

</LinearLayout>
