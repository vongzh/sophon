<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/sp_bg_card_raised"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 顶部标题与关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="车载免流极速快传"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_title"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sp_bg_pill"
            android:contentDescription="关闭"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_action_close"
            android:tint="@color/sp_tx2" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 流量消耗 · 手机直连车机 · 高清原画批量高速导出"
        android:textColor="@color/sp_tx2"
        android:textSize="@dimen/sp_t_label" />

    <!-- 二维码展示区 (精致白色卡片圆角) -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/sp_bg_input_field"
        android:backgroundTint="@color/sp_osd_tx"
        android:clipToOutline="true"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Lan Share QR Code" />

        <LinearLayout
            android:id="@+id/layout_no_network"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_section_network"
                android:tint="@color/sp_tx3"
                android:contentDescription="未联网" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未获取到局域网 IP"
                android:textColor="@color/sp_tx2"
                android:textSize="@dimen/sp_t_caption" />
        </LinearLayout>
    </FrameLayout>

    <!-- 提示与操作链接 (点击一键复制，带分享图标) -->
    <TextView
        android:id="@+id/tv_share_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/sp_bg_pill"
        android:drawableEnd="@drawable/ic_action_share"
        android:drawablePadding="8dp"
        android:drawableTint="@color/sp_ac"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="http://--:8088"
        android:textColor="@color/sp_ac"
        android:textSize="@dimen/sp_t_subtitle"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layout_unconnected_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_retry_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="重新检测"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_label" />

        <TextView
            android:id="@+id/btn_open_hotspot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/sp_bg_pill_accent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="车机网络设置"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_label"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_share_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="① 手机连接车机 Wi-Fi 热点\n② 微信或手机系统相机扫描上方二维码\n③ 浏览器即开点播与原画下载，不耗手机流量"
        android:textColor="@color/sp_tx2"
        android:textSize="@dimen/sp_t_label" />

</LinearLayout>
