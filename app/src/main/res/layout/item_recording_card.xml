<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_cockpit_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- 视频封面缩略图容器 (12dp 圆角裁切) -->
    <FrameLayout
        android:layout_width="144dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_cockpit_card_elevated"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_record_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- 播放轻量半透明微光药丸 -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_pill">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="▶"
                android:textColor="@color/flyme_cyan"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- 锁档标签 (发生碰撞或用户锁档) -->
        <TextView
            android:id="@+id/tv_badge_locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_pill_active"
            android:backgroundTint="@color/accent_danger"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="加锁保护"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 视频规格与时间戳信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-14 09:12:00"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_record_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="时长: 01:00  ·  大小: 72.5 MB  ·  四路全景"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 右侧操作药丸按键区 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_record_lock_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="加锁"
            android:textColor="@color/accent_warning"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_record_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="删除"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
