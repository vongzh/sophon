<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     录像卡片 · 设计稿 S3 列表项（docs/design/Sophon-UI-Design-v3.html）
     尺度依据：126×71 + 时长角标 + 锁定锁 + 三段元数据
     =================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/sp_s_12"
    android:layout_marginVertical="@dimen/sp_s_4"
    android:background="@drawable/sp_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/sp_s_8">

    <!-- 缩略图 (126dp × 71dp 车规实测尺度) -->
    <FrameLayout
        android:layout_width="126dp"
        android:layout_height="71dp"
        android:background="@drawable/sp_bg_card_inner"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/iv_record_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="录像切片缩略图" />

        <!-- 镜头角标 (左下角) -->
        <TextView
            android:id="@+id/tv_badge_cam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="4dp"
            android:background="@drawable/sp_bg_osd_chip"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="--"
            android:textColor="@color/sp_osd_tx"
            android:textSize="@dimen/sp_t_micro"
            android:textStyle="bold" />

        <!-- 加锁标记 (左上角) -->
        <TextView
            android:id="@+id/tv_badge_locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="4dp"
            android:background="@drawable/sp_bg_pill"
            android:backgroundTint="@color/sp_dg"
            android:drawableStart="@drawable/ic_action_lock"
            android:drawablePadding="2dp"
            android:drawableTint="@color/sp_osd_tx"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/sp_osd_tx"
            android:textSize="@dimen/sp_t_micro"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 时长角标 (右下角) -->
        <TextView
            android:id="@+id/tv_badge_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/sp_bg_osd_chip"
            android:fontFamily="monospace"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="--:--"
            android:textColor="@color/sp_osd_tx"
            android:textSize="@dimen/sp_t_micro" />
    </FrameLayout>

    <!-- 三段信息区 (主标题 / 副说明 / 数值与格式) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_s_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="--:--:--"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_record_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--  ·  --  ·  --"
            android:textColor="@color/sp_tx3"
            android:textSize="@dimen/sp_t_caption" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tag_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sp_bg_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="--"
                android:textColor="@color/sp_tx3"
                android:textSize="@dimen/sp_t_micro" />

            <TextView
                android:id="@+id/tv_badge_res"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/sp_bg_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="--"
                android:textColor="@color/sp_tx3"
                android:textSize="@dimen/sp_t_micro" />
        </LinearLayout>
    </LinearLayout>

    <!-- 侧边快捷操作键 (加锁 / 删除) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_record_lock_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sp_s_6"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="@dimen/sp_s_12"
            android:paddingVertical="@dimen/sp_s_6"
            android:text="加锁"
            android:textColor="@color/sp_wn"
            android:textSize="@dimen/sp_t_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_record_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sp_bg_pill"
            android:paddingHorizontal="@dimen/sp_s_12"
            android:paddingVertical="@dimen/sp_s_6"
            android:text="删除"
            android:textColor="@color/sp_dg"
            android:textSize="@dimen/sp_t_caption" />
    </LinearLayout>

</LinearLayout>
