<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/sp_bg_sheet"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 标题与状态行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_panel_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="○ 待命中"
            android:textColor="@color/sp_tx2"
            android:textSize="@dimen/sp_t_label"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/tv_panel_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="收起面板"
            android:padding="4dp"
            android:src="@drawable/ic_action_close"
            android:tint="@color/sp_tx2" />
    </LinearLayout>

    <!-- 存储状态行 -->
    <TextView
        android:id="@+id/tv_panel_storage_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="外接存储: 正常已挂载"
        android:textColor="@color/sp_tx2"
        android:textSize="@dimen/sp_t_caption" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/sp_line2" />

    <!--  快捷操作按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_panel_snapshot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:paddingVertical="8dp"
            android:drawableStart="@drawable/ic_action_camera"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_tx"
            android:text="抓拍"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_label" />

        <TextView
            android:id="@+id/btn_panel_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:paddingVertical="8dp"
            android:drawableStart="@drawable/ic_action_lock"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_wn"
            android:text="加锁"
            android:textColor="@color/sp_wn"
            android:textSize="@dimen/sp_t_label" />

        <TextView
            android:id="@+id/btn_panel_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:paddingVertical="8dp"
            android:drawableStart="@drawable/ic_action_share"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_ac"
            android:text="快传"
            android:textColor="@color/sp_ac"
            android:textSize="@dimen/sp_t_label" />

        <TextView
            android:id="@+id/btn_panel_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:paddingVertical="8dp"
            android:drawableStart="@drawable/ic_action_home"
            android:drawablePadding="@dimen/sp_s_6"
            android:drawableTint="@color/sp_tx"
            android:text="主页"
            android:textColor="@color/sp_tx"
            android:textSize="@dimen/sp_t_label" />
    </LinearLayout>

</LinearLayout>
