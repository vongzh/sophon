<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/sp_bg_sheet"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 标题与状态行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/sp_ac"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_panel_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="● 录制中"
            android:textColor="@color/sp_dg"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_panel_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="✕"
            android:textColor="@color/sp_tx2"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 存储状态行 -->
    <TextView
        android:id="@+id/tv_panel_storage_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="U盘状态: 正常已挂载"
        android:textColor="@color/sp_tx2"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/sp_line2" />

    <!--  快捷操作按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_panel_snapshot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="📷 抓拍"
            android:textColor="@color/sp_tx"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_panel_lock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="🔒 加锁"
            android:textColor="@color/sp_wn"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_panel_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="📲 快传"
            android:textColor="@color/sp_ac"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_panel_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/sp_bg_pill"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="🏠 主页"
            android:textColor="@color/sp_tx"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
