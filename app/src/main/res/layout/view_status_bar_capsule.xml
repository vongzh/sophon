<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capsule_root"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:background="@drawable/sp_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <!-- 录制呼吸红点 -->
    <View
        android:id="@+id/view_rec_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/sp_bg_pill"
        android:backgroundTint="@color/sp_dg" />

    <!-- 录制时间跑秒 -->
    <TextView
        android:id="@+id/tv_capsule_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:text="待命中"
        android:textColor="@color/sp_tx"
        android:textSize="@dimen/sp_t_label"
        android:textStyle="bold" />

    <!-- 外接存储状态指示 -->
    <ImageView
        android:id="@+id/tv_capsule_usb"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="外接存储状态"
        android:src="@drawable/ic_usb_drive"
        android:tint="@color/sp_ac" />

</LinearLayout>
