<?xml version="1.0" encoding="utf-8"?>
<!--  导航项选中态：主色淡底 + 左侧 3dp 主色指示条 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/sp_r_card" />
            <solid android:color="@color/sp_acbg" />
            <stroke
                android:width="1dp"
                android:color="@color/sp_acln" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/sp_ac" />
        </shape>
    </item>
</layer-list>
