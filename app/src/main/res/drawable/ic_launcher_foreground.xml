<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 底座微光大圆 (FlymeAuto 车规级大卡片层次底座) -->
    <path
        android:pathData="M 54,22 C 71.67,22 86,36.33 86,54 C 86,71.67 71.67,86 54,86 C 36.33,86 22,71.67 22,54 C 22,36.33 36.33,22 54,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A00D4AA" />
                <item android:offset="1.0" android:color="#0500A382" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 四向全维感知标尺刻度 (前/后/左/右 四通道相机象征) -->
    <!-- 前 (North) -->
    <path
        android:pathData="M 54,24 L 54,29"
        android:strokeColor="#FF00A382"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <!-- 后 (South) -->
    <path
        android:pathData="M 54,79 L 54,84"
        android:strokeColor="#FF00A382"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <!-- 左 (West) -->
    <path
        android:pathData="M 24,54 L 29,54"
        android:strokeColor="#FF00A382"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <!-- 右 (East) -->
    <path
        android:pathData="M 79,54 L 84,54"
        android:strokeColor="#FF00A382"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- 3. 外层精密光学环 (高清晰翡翠青流线) -->
    <path
        android:pathData="M 54,32 C 66.15,32 76,41.85 76,54 C 76,66.15 66.15,76 54,76 C 41.85,76 32,41.85 32,54 C 32,41.85 41.85,32 54,32 Z"
        android:strokeWidth="2.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="32"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D4AA" />
                <item android:offset="1.0" android:color="#FF0A84FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. 极视核心：中层智瞳光圈孔径 (纯白与魅族青渐变) -->
    <path
        android:pathData="M 54,41 C 61.18,41 67,46.82 67,54 C 67,61.18 61.18,67 54,67 C 46.82,67 41,61.18 41,54 C 41,46.82 46.82,41 54,41 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41"
                android:startY="41"
                android:endX="67"
                android:endY="67"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D4AA" />
                <item android:offset="0.7" android:color="#FF009E7E" />
                <item android:offset="1.0" android:color="#FF0A84FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. 镜头核心深邃晶体瞳孔 -->
    <path
        android:pathData="M 54,47 C 57.87,47 61,50.13 61,54 C 61,57.87 57.87,61 54,61 C 50.13,61 47,57.87 47,54 C 47,50.13 50.13,47 54,47 Z"
        android:fillColor="#FF0D1520" />

    <!-- 6. 镜头高光反射弧 (纯白通透反光) -->
    <path
        android:pathData="M 49,50 C 51,48 54,48 56,49"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- 7. 领克08 破晓之光灵动流线 (右侧展翼光弧) -->
    <path
        android:pathData="M 66,36 C 75,41 79,48 79,55 C 79,62 75,69 66,74"
        android:strokeWidth="2.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="66"
                android:startY="36"
                android:endX="79"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D4AA" />
                <item android:offset="1.0" android:color="#3300D4AA" />
            </gradient>
        </aapt:attr>
    </path>

    <!--  8. 灵动星芒能量点 -->
    <path
        android:pathData="M 82,34 A 1.8,1.8 0 1,1 82,33.9 Z"
        android:fillColor="#FF00D4AA" />

</vector>
