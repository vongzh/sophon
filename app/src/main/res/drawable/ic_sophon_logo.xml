<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================
     极视 车规智瞳紧凑矢量徽标 (Compact Logo)
     包含完整闭环外镜圈、内嵌四向标尺、多阶光圈与核心瞳孔
     =================================================================== -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="28"
    android:viewportHeight="28">

    <!-- 0. 镜片深邃微透底盘 -->
    <path
        android:pathData="M 14,2 A 12,12 0 1,1 13.99,2 Z"
        android:fillColor="#1500D4AA" />

    <!-- 1. 外层精密镜筒外圈 (完整外圈闭环) -->
    <path
        android:pathData="M 14,2 A 12,12 0 1,1 13.99,2 Z"
        android:strokeColor="@color/sp_ac"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- 2. 四向全维内嵌标尺刻度 (前/后/左/右 严格内嵌在圆内) -->
    <path
        android:pathData="M 14,2 L 14,5.5 M 14,22.5 L 14,26 M 2,14 L 5.5,14 M 22.5,14 L 26,14"
        android:strokeColor="@color/sp_ac"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- 3. 中圈光学光圈 (Aperture Iris) -->
    <path
        android:pathData="M 14,7 A 7,7 0 1,1 13.99,7 Z"
        android:strokeColor="@color/sp_ac"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <!-- 4. 核心感知瞳孔 (Core Focus Pupil) -->
    <path
        android:pathData="M 14,14 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="@color/sp_ac" />

    <!-- 5. 瞳孔微光高光点 -->
    <path
        android:pathData="M 13.2,13.2 m -0.6,0 a 0.6,0.6 0 1,0 1.2,0 a 0.6,0.6 0 1,0 -1.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
