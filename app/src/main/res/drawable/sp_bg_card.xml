<?xml version="1.0" encoding="utf-8"?>
<!--  基础卡片：发丝描边 + 顶部 1dp 内高光（替代旧版粗描边玻璃拟态） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/sp_r_card" />
            <solid android:color="@color/sp_surf" />
            <stroke
                android:width="1dp"
                android:color="@color/sp_line" />
        </shape>
    </item>
</layer-list>
