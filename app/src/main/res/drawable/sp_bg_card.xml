<?xml version="1.0" encoding="utf-8"?>
<!--  基础卡片：发丝描边 + 顶部 1dp 内高光（替代旧版粗描边玻璃拟态） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/sp_r_card" />
            <solid android:color="@color/sp_surf" />
            <stroke
                android:width="1dp"
                android:color="@color/sp_line" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="2dp">
        <shape android:shape="rectangle">
            <corners
                android:radius="@dimen/sp_r_card"
                android:topLeftRadius="@dimen/sp_r_card"
                android:topRightRadius="@dimen/sp_r_card" />
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/sp_top_hi" />
        </shape>
    </item>
</layer-list>
