<?xml version="1.0" encoding="utf-8"?>
<!--  玻璃质感方键（48dp）：浮于视频之上的控制键，半透明底 + 发丝描边 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sp_acring">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/sp_r_ctrl" />
            <solid android:color="@color/sp_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/sp_linew" />
        </shape>
    </item>
</ripple>
