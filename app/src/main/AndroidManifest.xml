<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 车机悬浮窗权限 (打灯盲区辅助) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 开机与电源唤醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 网络通信与状态监听权限 (用于 Bark / Telegram / 飞书 远程预警与局域网快传) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 车载 GNSS / GPS 遥测定位与哨兵围栏权限。
         车规事故取证要求在录像与抓拍元数据中记录真实经纬度与车速；
         若用户未授权或无硬件模块，系统静默降级呈现占位横杠，严禁强弹权限或造假。 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 车内录音权限 (循环录像音轨) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 外部 U 盘存储访问权限 (严格禁止写入内部闪存) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />

    <!-- ===================================================================
         车规车身信号权限 (Android Automotive VHAL 只读订阅)
         对应 NativeVehiclePropertyObserver 反射调用的 CarPropertyManager 属性：
         车速 / 挡位 / 转向灯 / 电源 / 动态状态 / 能量 / 车外环境温度 / 车身信息

         【重要前提】CAR_* 权限保护级别为 signature|privileged，普通第三方用户态
         应用即便声明也不会被系统授予。若 APK 未预装至 /system/priv-app 或未使用
         平台签名，registerCallback 与 getProperty 仍会抛 SecurityException。
         该异常已在 NativeVehiclePropertyObserver 中单独捕获并显式告警，
         通过 VehicleSignalBus.vhalAuthError 上抛，避免"静默降级为 0 / P 挡"。
         =================================================================== -->
    <!-- 车速 PERF_VEHICLE_SPEED (0x11600207) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 挡位 GEAR_SELECTION (0x11400400) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 转向灯 TURN_SIGNAL_STATE (0x11400408) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <!-- 电源状态 (哨兵模式低功耗休眠判定) -->
    <uses-permission android:name="android.car.permission.CAR_POWER" />
    <!-- 车身动态状态与制动 -->
    <uses-permission android:name="android.car.permission.CAR_DYNAMICS_STATE" />
    <!-- 12V 蓄电池电压与能耗 -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <!-- 车外环境温度 (状态栏温度数据源) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <!-- 车门与车身静态信息 -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <!-- 车厂私有扩展属性 (领克 / 极氪 座舱) -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <!-- 车速单位换算 (km/h 与 mph 显示单位) -->
    <uses-permission android:name="android.car.permission.READ_CAR_DISPLAY_UNITS" />

    <application
        android:name=".SophonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sophon">

        <!-- 主控界面 (UI 进程，支持原生画中画微窗) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 哨兵震动告警中控屏威慑视窗 -->
        <activity
            android:name=".ui.sentry.SentryDeterrentActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Sophon"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

<!-- 四路同步回放播放器 -->
        <activity
            android:name=".ui.playback.QuadSyncPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

<!-- 核心视觉与录制前台服务 (统一前台进程，避免多进程单例双花与状态孤岛) -->
        <service
            android:name=".service.SophonCoreService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera|dataSync|microphone" />

        <!-- 盲区补盲悬浮窗服务 -->
        <service
            android:name=".service.BlindSpotOverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- 顶部状态栏常驻胶囊与快捷卡片服务 -->
        <service
            android:name=".ui.statusbar.StatusBarCapsuleService"
            android:enabled="true"
            android:exported="false" />

        <!-- 悬浮窗矩阵 · 后视角小窗 (R 挡联动，替代流媒体后视镜) -->
        <service
            android:name=".service.RearViewOverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- 悬浮窗矩阵 · 车辆状态小窗 (车速 / 挡位 / 电压 / 录制 / 哨兵 / 存储) -->
        <service
            android:name=".service.VehicleStatusOverlayService"
            android:enabled="true"
            android:exported="false" />

        <!-- 悬浮窗矩阵 · 功能悬浮球 (可拖拽快捷菜单) -->
        <service
            android:name=".service.AssistBallOverlayService"
            android:enabled="true"
            android:exported="false" />



        <!-- 通知栏快捷动作广播接收器 -->
        <receiver
            android:name=".core.notification.SophonNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vongzh.sophon.action.NOTIF_SNAPSHOT" />
                <action android:name="com.vongzh.sophon.action.NOTIF_LOCK_EVENT" />
            </intent-filter>
        </receiver>

        <!-- 领克08 原厂休眠唤醒协同广播接收器 -->
        <receiver
            android:name=".core.vhal.LynkcoWakeupReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lynkco.intent.action.STR_RESUME" />
                <action android:name="com.lynkco.intent.action.SYSTEM_READY" />
                <action android:name="com.lynkco.intent.action.WAKEUP" />
                <action android:name="com.lynkco.intent.action.STR_SUSPEND" />
                <action android:name="com.lynkco.intent.action.PRE_SLEEP" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

        <!-- 开机通电与包替换自启广播接收器 -->
        <receiver
            android:name=".core.vhal.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 外置 U 盘热插拔与挂载广播接收器 -->
        <receiver
            android:name=".core.storage.UsbStorageMountReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <action android:name="android.intent.action.MEDIA_UNMOUNTED" />
                <action android:name="android.intent.action.MEDIA_REMOVED" />
                <action android:name="android.intent.action.MEDIA_EJECT" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
                <action android:name="android.os.storage.action.VOLUME_STATE_CHANGED" />
            </intent-filter>
        </receiver>

            <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Sophon" />
</application>

</manifest>
