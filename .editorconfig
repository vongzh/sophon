root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin 官方风格：4 空格缩进，续行 8 空格，允许尾逗号
[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 8
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
max_line_length = 120

[*.{java,xml,gradle}]
indent_size = 4

[*.{yml,yaml,json,properties,toml}]
indent_size = 2

[*.md]
# Markdown 依赖行尾双空格实现强制换行，不能去尾空格
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
