# 默认：交由 Git 自动判定是否文本文件
* text=auto

# 源码与配置文件：索引与工作区统一 LF
*.kt  text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.pro text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制：禁止任何行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.apk  binary
*.aab  binary
*.jar  binary
*.jks  binary
*.keystore binary
*.ttf  binary
*.otf  binary
*.so   binary
